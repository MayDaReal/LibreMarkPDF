# Normalize text files while preserving platform-specific scripts.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.spec text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.bat text eol=crlf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
